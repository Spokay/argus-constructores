# Copy to .env (git-ignored). Read by docker compose and by the backend
# (spring.config.import), so both share the same database credentials.
DB_URL=jdbc:postgresql://localhost:5432/argus
DB_USERNAME=argus
DB_PASSWORD=change-me

# HS256 signing key, at least 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=

# First admin account, created only while no account exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
