{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "HUSKY=0 npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/argus-constructores-frontend/browser",
  "redirects": [{ "source": "/", "destination": "/es/", "permanent": false }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://argus-api.spokayhub.top/api/:path*" },
    { "source": "/es/:path*", "destination": "/es/index.html" },
    { "source": "/en/:path*", "destination": "/en/index.html" }
  ]
}
